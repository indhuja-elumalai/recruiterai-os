{
  "name": "recruiterai-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted recruitment operating system for modern hiring teams.",
  "author": "Indhuja Elumalai <indhujabusiness@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w @recruiterai/web\" \"npm run dev -w @recruiterai/api\"",
    "dev:web": "npm run dev -w @recruiterai/web",
    "dev:api": "npm run dev -w @recruiterai/api",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "seed": "npm run seed -w @recruiterai/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
