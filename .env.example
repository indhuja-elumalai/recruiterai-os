# Copy this file to .env and fill secrets only in your local editor.
# Never commit the populated .env file.

# Application
NODE_ENV=development
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
APP_VERSION=0.1.0

# Database
MONGODB_URI=mongodb://localhost:27017/recruiterai

# Authentication (generate unique values; implemented in the auth branch)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Demo seed data
SEED_ORGANIZATION_NAME=Ind Technologies
SEED_ADMIN_EMAIL=admin@demo.recruiterai.dev
SEED_RECRUITER_EMAIL=recruiter@demo.recruiterai.dev
SEED_MANAGER_EMAIL=manager@demo.recruiterai.dev
SEED_INTERVIEWER_EMAIL=interviewer@demo.recruiterai.dev
SEED_CANDIDATE_EMAIL=candidate@demo.recruiterai.dev
SEED_DEMO_PASSWORD=

# AI (optional until the AI matching branch)
GEMINI_API_KEY=
GEMINI_MODEL=

# Transactional email (optional)
RESEND_API_KEY=
EMAIL_FROM=

# External file storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
